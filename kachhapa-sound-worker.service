[Unit]
Description=Kachhapa durable sound upload worker
After=network.target postgresql.service
Requires=kachhapa-backend.service

[Service]
Type=simple
User=ijohnson
Group=www-data
WorkingDirectory=/home/ijohnson/Kachhapa/Flask
Environment="DATABASE_URL=postgresql://admin:admin@localhost:5432/db"
Environment="TMPDIR=/home/ijohnson/Kachhapa/tmp"
Environment="SOUND_UPLOAD_ROOT=/home/ijohnson/Kachhapa/tmp/sound-uploads"
UMask=0007
Nice=10
IOSchedulingClass=idle
ExecStart=/home/ijohnson/Kachhapa/venv/bin/flask --app app process-sound-uploads
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
